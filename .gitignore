node_modules/
dist/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# --- large raw geodata (re-downloadable from LGL-BW open data) ---
geoimages/**/*.tif
geoimages/**/*.tfw
geoimages/**/*.aux.xml

# --- large original photos (downscaled copies committed under orchard/public/photos) ---
newimages/

