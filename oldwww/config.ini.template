# Template for oldwww/config.ini (NOT in git when real).
# Copy to oldwww/config.ini and fill in real values.

[db]
dbname = <database-name>
dbserv = <db-host>          # e.g. the sensor DB host running MySQL/MariaDB
# sensor DB account with write access to the sensor tables
dbuser = <db-user>
dbpass = <db-password>
